# Copie para .streamlit/secrets.toml. Nunca versione o arquivo preenchido.
# Sem esse arquivo, o aplicativo usa automaticamente data/macro_mensal.csv.
# Supabase: abra o projeto > Connect > Session pooler e copie os campos reais.
# Não deduza o host a partir da região: use exatamente o host mostrado no painel.
[connections.postgresql]
dialect = "postgresql"
driver = "psycopg"
host = "COPIE_O_HOST_DO_SESSION_POOLER"
port = 5432
database = "postgres"
username = "postgres.REFERENCIA_DO_PROJETO"
password = "SENHA_DO_BANCO_SUPABASE"

[connections.postgresql.query]
sslmode = "require"
connect_timeout = "5"
